########################################
# TELEGRAM API CREDENTIALS (Required)
# Get these from https://my.telegram.org
########################################
API_ID=1234567
API_HASH=your_api_hash_here

########################################
# BOT TOKEN (Required)
# Get this from @BotFather on Telegram
########################################
BOT_TOKEN=1234567890:your_bot_token_here

########################################
# OWNER / ADMIN CONFIG
########################################
# Your own Telegram user ID (numeric)
OWNER_ID=841851780

# Space-separated list of extra Telegram user IDs allowed to use the bot
# Example: AUTH_USERS=111111111 222222222
AUTH_USERS=

########################################
# DATABASE (Required)
# MongoDB connection string, e.g. from MongoDB Atlas
########################################
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/filestream

########################################
# FORCE SUBSCRIBE
########################################
# Username (without @) of the channel users must join to use the bot
UPDATES_CHANNEL=Nex_Botz

# Channel ID to check force-sub against (optional, overrides UPDATES_CHANNEL check)
FORCE_SUB_ID=

# Enable/disable force subscribe (true/false)
FORCE_UPDATES_CHANNEL=true

########################################
# LOG CHANNELS (Required)
# Numeric IDs of private Telegram channels/groups used for logging
########################################
# Channel where uploaded files are logged/stored
FLOG_CHANNEL=-1001234567890

# Channel where user activity/errors are logged
ULOG_CHANNEL=-1001234567891

########################################
# BOT BEHAVIOUR
########################################
# Number of pyrogram workers (parallel command handling)
WORKERS=6

# Session name used by pyrogram
SESSION_NAME=FileStream

# Seconds to sleep on FloodWait before retrying
SLEEP_THRESHOLD=60

# primary = main bot instance, secondary = helper/worker instance for load balancing
MODE=primary

########################################
# IMAGES SHOWN IN BOT MESSAGES
########################################
# Thumbnail image used when sending file info
FILE_PIC=https://files.catbox.moe/u396zp.png

# Comma-separated list of images shown randomly on /start
START_PICS=https://files.catbox.moe/e6t097.png,https://files.catbox.moe/4l7cc0.png,https://files.catbox.moe/32tmev.png,https://files.catbox.moe/ntqmum.png
# Image shown on the "join channel to verify" prompt
VERIFY_PIC=https://files.catbox.moe/fbp0ua.png

########################################
# WEB SERVER (streaming/download links)
########################################
# Port the aiohttp server listens on (Render/Heroku set this automatically)
PORT=8080

# Address the server binds to
BIND_ADDRESS=0.0.0.0

# Interval (seconds) between keep-alive pings
PING_INTERVAL=1200

# Whether your public domain uses https (1/0, true/false)
HAS_SSL=1

# Whether to omit the port number from generated links (1/0, true/false)
NO_PORT=1

# Your public domain WITHOUT https:// and WITHOUT trailing slash
# e.g. filestream-bot-njtx.onrender.com
FQDN=your-app-name.onrender.com

########################################
# LINK SECURITY (stream/download link signing)
########################################
# Secret used to sign watch/download links (HMAC-SHA256).
# Set this to a long random string in production, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# If left blank, it falls back to API_HASH + BOT_TOKEN (works, but set your own).
SECRET_KEY=

# How long a generated stream/download link stays valid, in seconds.
# Default: 21600 (6 hours)
LINK_EXPIRY_SECONDS=21600

########################################
# KEEP ALIVE (optional)
########################################
# URL to ping periodically to prevent the free-tier host from sleeping
# Usually your own FQDN, e.g. https://your-app-name.onrender.com
KEEP_ALIVE_URL=
